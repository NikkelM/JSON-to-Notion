{
	"name": "json-to-notion",
	"type": "module",
	"version": "2.0.0",
	"description": "CLI to import a JSON file into a Notion database - for cases where a CSV is not available and converting JSON to CSV would be too complicated.",
	"keywords": [
		"notion",
		"json",
		"import",
		"notion-api",
		"notion-database"
	],
	"author": {
		"name": "Nikkel Mollenhauer",
		"email": "contact@nikkelm.dev"
	},
	"license": "GPL-3.0-or-later",
	"homepage": "https://github.com/NikkelM/JSON-to-Notion#readme",
	"main": "index.js",
	"bin": {
		"json-to-notion": "bin/cli.js"
	},
	"files": [
		"bin/",
		"index.js",
		"js/",
		"config.schema.json",
		"config.default.json"
	],
	"engines": {
		"node": ">=22.13.0"
	},
	"scripts": {
		"test": "node --test --experimental-test-module-mocks"
	},
	"funding": [
		"https://github.com/sponsors/NikkelM",
		"https://ko-fi.com/nikkelm"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/NikkelM/JSON-to-Notion.git"
	},
	"bugs": {
		"url": "https://github.com/NikkelM/JSON-to-Notion/issues"
	},
	"dependencies": {
		"@inquirer/prompts": "^8.5.2",
		"@notionhq/client": "^5.0.0",
		"cli-progress": "^3.11.2",
		"commander": "^15.0.0",
		"jsonschema": "^1.4.1"
	}
}
